{
    "name": "mrpythonist/background-job-manager",
    "description": "Lightweight background job management dashboard, a simplified Laravel Horizon.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php artisan test",
        "lint": "php -l app/Services/QueueStatsService.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
