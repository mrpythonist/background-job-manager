APP_NAME="Background Job Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=background_jobs
DB_USERNAME=bjm
DB_PASSWORD=secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis

# Optional. When set, write endpoints require header X-API-Key: <key>.
JOB_MANAGER_API_KEY=

# Seconds without a heartbeat before a worker is considered stale.
WORKER_STALE_AFTER_SECONDS=60

FRONTEND_URL=http://localhost:5173
